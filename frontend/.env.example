# Copy this file to .env.local and fill in your Supabase project values.
# Never commit .env.local (it's already in .gitignore).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Set to "true" once you want the app to hit real Supabase data
# instead of the built-in mock data set.
VITE_USE_SUPABASE=false

# Express backend — only used by the AI chat (OpenAI key lives there,
# server-side only; never put it in a VITE_* var).
VITE_API_BASE_URL=http://localhost:4000
